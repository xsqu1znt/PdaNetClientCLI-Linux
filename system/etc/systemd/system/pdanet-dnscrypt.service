[Unit]
Description=PDANet DNS-over-HTTPS proxy
After=network.target

[Service]
Type=simple
DynamicUser=yes
ExecStart=/usr/bin/dnscrypt-proxy -config /etc/dnscrypt-proxy-pdanet.toml -syslog
Restart=on-failure
RestartSec=2s
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
