[Unit]
Description=PDANet transparent TCP proxy
After=network.target

[Service]
Type=simple
DynamicUser=yes
ExecStart=/usr/bin/redsocks -c /etc/redsocks-pdanet.conf
Restart=on-failure
RestartSec=2s
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET

[Install]
WantedBy=multi-user.target
